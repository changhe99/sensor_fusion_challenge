<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ekf_fusion</name>
  <version>0.1.0</version>
  <description>
    Custom error-state EKF fusing the BMI088 IMU (bmi088_driver,
    sensor_msgs/Imu on /imu/data_raw) with the ZED-F9P GNSS
    (gnss_driver, sensor_msgs/NavSatFix on /gnss/fix and
    geometry_msgs/TwistWithCovarianceStamped on /gnss/vel). Publishes a fused
    nav_msgs/Odometry estimate on /odometry/filtered.
  </description>
  <maintainer email="robert.he1999@gmail.com">Chang</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
