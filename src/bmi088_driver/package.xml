<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bmi088_driver</name>
  <version>0.1.0</version>
  <description>
    ROS 2 driver for the Bosch BMI088 (Shuttle Board 3.0) IMU. Reads the
    accelerometer and gyroscope over a swappable transport (default: Bosch
    Application Board 3.0/3.1 via the COINES SDK) and publishes
    sensor_msgs/Imu.
  </description>
  <maintainer email="robert.he1999@gmail.com">Chang</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <!-- coinespy is the Bosch COINES Python wrapper; install via pip, not rosdep. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
